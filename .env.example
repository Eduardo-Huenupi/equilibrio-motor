# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.

# Claves de acceso a la API: una clave larga y aleatoria por usuario o integración.
# Genera cada clave con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MOTOR_API_KEYS={"CAMBIA-ESTA-CLAVE": {"org_id": "mi-organizacion", "usuario": "admin", "rol": "admin"}}

# Almacén: "memoria" (se pierde al reiniciar) o "supabase"
MOTOR_ALMACEN=memoria
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Modelo que redacta las respuestas. Sin clave se usa el modo extractivo local.
ANTHROPIC_API_KEY=
MOTOR_MODELO=claude-sonnet-5-5

# Embeddings semánticos. Sin clave se usa el embedder local por palabras.
VOYAGE_API_KEY=
VOYAGE_MODELO=voyage-3

# Similitud mínima para intentar responder. Calíbralo con los evals.
# MOTOR_UMBRAL=0.12
